# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
SITE_ID=PHC-INDORE-01
DEVICE_ID=FUNDUS-CAM-001

# ─── Edge persistence (offline-first, always required) ──────────────────────
SQLITE_PATH=./data/retinaguard.db

# ─── District node (PostgreSQL) — only needed on the district server ────────
DISTRICT_SYNC_ENABLED=false
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=retinaguard_district
PG_USER=retinaguard
PG_PASSWORD=change-me
PG_SSL=false

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-64-char-random-string-in-production
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
OFFLINE_GRACE_HOURS=72
BCRYPT_ROUNDS=12

# ─── Uploads ────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=26214400
ALLOWED_MIME=image/jpeg,image/png,image/tiff

# ─── Clinical / safety configuration (see docs/MATLAB_INTEGRATION.md) ───────
MAX_RECAPTURE_ATTEMPTS=2
ABSTENTION_CONFIDENCE_THRESHOLD=0.70
REFERABLE_PROBABILITY_THRESHOLD=0.50
AUTO_CLEAR_AUDIT_SAMPLE_RATE=0.05
MANDATORY_HUMAN_REVIEW=true

# ─── MATLAB integration ─────────────────────────────────────────────────────
MATLAB_ADAPTER=mock
MATLAB_BIN=/usr/local/MATLAB/R2024b/bin/matlab
MATLAB_SCRIPT_DIR=./src/matlab/scripts
MATLAB_TIMEOUT_MS=120000
MODEL_VERSION=retinaguard-effnetb0-512-v1
MODEL_HASH=TO_BE_VERIFIED
PREPROCESSING_HASH=TO_BE_VERIFIED

# ─── Sync ───────────────────────────────────────────────────────────────────
SYNC_BATCH_SIZE=25
SYNC_MAX_ATTEMPTS=8
SYNC_BASE_BACKOFF_MS=5000
SYNC_INTERVAL_MS=60000

# ─── Rate limiting / CORS ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
