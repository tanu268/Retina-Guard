{
  "name": "retinaguard-backend",
  "version": "1.0.0",
  "description": "RetinaGuard — offline-first Explainable AI backend for Diabetic Retinopathy screening (SIH 2026, PS 26038, Team DrigShift)",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/database/migrate.js up",
    "migrate:status": "node src/database/migrate.js status",
    "seed": "node src/database/seed.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --watch --runInBand",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage",
    "lint": "eslint src tests",
    "sync:worker": "node scripts/syncWorker.js",
    "docker:up": "docker compose up --build"
  },
  "keywords": [
    "diabetic-retinopathy",
    "explainable-ai",
    "offline-first",
    "matlab",
    "sih2026"
  ],
  "author": "Team DrigShift",
  "license": "MIT",
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "0.15.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^9.14.0",
    "jest": "^29.7.0",
    "pdf-parse": "^1.1.1",
    "pino-pretty": "^11.3.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/database/migrate.js",
      "!src/database/seed.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 85,
        "lines": 85,
        "statements": 85
      }
    },
    "setupFilesAfterEnv": [
      "<rootDir>/tests/helpers/setup.js"
    ],
    "testTimeout": 20000
  }
}
